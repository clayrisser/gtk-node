{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["build/", "coverage/"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ]
  }
}
